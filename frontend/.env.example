# In local dev, Vite proxies /api to http://localhost:8000 automatically
# (see vite.config.ts) - you don't need this file for local development.
#
# In production (e.g. Render static site), set this to your deployed
# backend's URL so the built app knows where to send API requests.
VITE_API_BASE_URL=https://your-backend.onrender.com
