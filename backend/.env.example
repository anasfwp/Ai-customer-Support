DATABASE_URL=sqlite:///./knowledge.db
LLM_PROVIDER=gemini
OPENAI_API_KEY=your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here
# Optional: chat models to try in order (fallbacks used when one is overloaded / out of quota)
# GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest
GROQ_API_KEY=your_groq_key_here
SECRET_KEY=your_generated_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DEBUG=True
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:5173"]
